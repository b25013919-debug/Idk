local farmHits, farmKills, farmStart = 0, 0, nil
local killedSeen = setmetatable({}, { __mode = "k" })
local retreating, retPlat, retBack = false, nil, nil
local function retreatStep()
    if not S.AntiDeath or retreating then return end
    local h, r = hum(), root()
    if not (h and r) or h.Health <= 0 then return end
    if h.Health / math.max(h.MaxHealth, 1) * 100 > S.DeathPct then return end
    retreating = true
    task.spawn(function()
        retBack = r.CFrame
        local y = r.Position.Y + 260
        retPlat = Instance.new("Part")
        retPlat.Size = Vector3.new(40, 2, 40)
        retPlat.Anchored = true
        retPlat.Material = Enum.Material.Neon
        retPlat.Color = ACC
        retPlat.Transparency = 0.4
        retPlat.CanQuery = false
        retPlat.Position = Vector3.new(r.Position.X, y, r.Position.Z)
        retPlat.Parent = workspace
        r.AssemblyLinearVelocity = Vector3.zero
        r.CFrame = CFrame.new(r.Position.X, y + 4, r.Position.Z)
        local t0 = tick()
        while alive and tick() - t0 < 14 do
            local h2 = hum()
            if not h2 or h2.Health <= 0 then break end
            if h2.Health / math.max(h2.MaxHealth, 1) >= 0.9 then break end
            task.wait(0.3)
        end
        local r2, h3 = root(), hum()
        if r2 and retBack and h3 and h3.Health > 0 then r2.CFrame = retBack end
        if retPlat then retPlat:Destroy() retPlat = nil end
        retreating = false
    end)
end
