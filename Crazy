local function isArmPart(part)
    local n = string.lower(part.Name)
    return n:find("arm") or n:find("hand") or n:find("sleeve") or n:find("glove") or n:find("finger") or n:find("wrist")
end
local function applyVM()
    local c = cam()
    if not c then return end
    local col = Color3.fromHSV((tick() * 0.35) % 1, 0.9, 1)
    for _, m in ipairs(c:GetChildren()) do
        if m:IsA("Model") or m:IsA("Folder") then
            for _, d in ipairs(m:GetDescendants()) do
                if d:IsA("BasePart") then
                    local arm = isArmPart(d)
                    local mode = arm and S.ArmMode or S.WeapMode
                    if not vmOrig[d] then vmOrig[d] = { d.Color, d.Transparency, d.Material } end
                    local o = vmOrig[d]
                    if S.ThirdPerson then
                        d.Transparency = 1
                    elseif mode == 1 then
                        d.Color, d.Transparency, d.Material = o[1], o[2], o[3]
                    elseif mode == 2 then
                        d.Color, d.Material, d.Transparency = col, Enum.Material.Neon, o[2]
                    elseif mode == 3 then
                        d.Color, d.Material, d.Transparency = ACC, Enum.Material.Neon, o[2]
                    elseif mode == 4 then
                        d.Transparency = math.max(o[2], S.ArmTrans / 100)
                    else
                        d.Color, d.Material, d.Transparency = col, Enum.Material.ForceField, o[2]
                    end
                end
            end
        end
    end
end
local function restoreVM()
    for d, o in pairs(vmOrig) do
        pcall(function()
            if d.Parent then d.Color, d.Transparency, d.Material = o[1], o[2], o[3] end
        end)
    end
    vmOrig = setmetatable({}, { __mode = "k" })
end

