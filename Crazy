        local b = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, f)
        b.Activated:Connect(function()
            S[key] = not S[key]
            render()
            if onChange then
                local okc, res = pcall(onChange, S[key])
                if okc and res == false then S[key] = not S[key] render() end
            end
        end)
        b.MouseEnter:Connect(function() tw(f, 0.18, { BackgroundColor3 = ITEM_H }) end)
        b.MouseLeave:Connect(function() tw(f, 0.18, { BackgroundColor3 = ITEM }) end)
    end
    local function slider(page, title, key, min, max, step, suffix, onChange)
        local f = new("Frame", { Size = UDim2.new(1, 0, 0, ITEMH + 16), BackgroundColor3 = ITEM, LayoutOrder = O() }, page)
        corner(f, 10)
        new("TextLabel", {
            Size = UDim2.new(1, -100, 0, 20), Position = UDim2.fromOffset(14, 7), BackgroundTransparency = 1, Text = title,
            TextColor3 = TX, Font = Enum.Font.Code, TextSize = TS_, TextXAlignment = Enum.TextXAlignment.Left,
        }, f)
        local val = new("TextLabel", {
            Size = UDim2.fromOffset(80, 20), Position = UDim2.new(1, -94, 0, 7), BackgroundTransparency = 1, Text = tostring(S[key]) .. (suffix or ""),
            TextColor3 = ACC, Font = Enum.Font.Code, TextSize = TS_, TextXAlignment = Enum.TextXAlignment.Right,
        }, f)
        onAccent(function(c) val.TextColor3 = c end)
        local track = new("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.new(0, 14, 1, -20), BackgroundColor3 = OFF }, f)
        corner(track, 3)
        local fill = new("Frame", { Size = UDim2.new((S[key] - min) / (max - min), 0, 1, 0), BackgroundColor3 = ACC, BorderSizePixel = 0 }, track)
        corner(fill, 3)
        onAccent(function(c) fill.BackgroundColor3 = c end)
        local knob = new("Frame", { Size = UDim2.fromOffset(16, 16), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(1, 0.5), BackgroundColor3 = Color3.new(1, 1, 1) }, fill)
        corner(knob, 8)
        local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.5, -15), BackgroundTransparency = 1, Text = "" }, track)
        local dragging = false
        local function setFromX(x)
            local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
            local v = math.clamp(min + math.floor((max - min) * a / step + 0.5) * step, min, max)
            S[key] = v
            val.Text = tostring(v) .. (suffix or "")
            tw(fill, 0.1, { Size = UDim2.new((v - min) / (max - min), 0, 1, 0) })
            if onChange then pcall(onChange, v) end
        end
        hit.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                page.ScrollingEnabled = false
                setFromX(i.Position.X)
            end
        end)
        bind(UIS.InputChanged, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                setFromX(i.Position.X)
            end
        end)
        bind(UIS.InputEnded, function(i)
            if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                dragging = false
                page.ScrollingEnabled = true
            end
        end)
    end
