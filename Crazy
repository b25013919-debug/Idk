        local bar = new("Frame", { Size = UDim2.new(0, 4, 1, -16), Position = UDim2.fromOffset(8, 8), BackgroundColor3 = color, BorderSizePixel = 0 }, t)
        corner(bar, 2)
        new("TextLabel", {
