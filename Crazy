-- ---- entities: players and NPCs (anything with a Humanoid)
local npcSet, ents = {}, {}
local function addNPC(d)
    if not d:IsA("Humanoid") then return end
    local m = d.Parent
    if not m or m == lp.Character or Players:GetPlayerFromCharacter(m) then return end
    npcSet[d] = true
    d.Destroying:Connect(function() npcSet[d] = nil end)
end
local function scanNPCs()
    npcSet = {}
    for _, d in ipairs(workspace:GetDescendants()) do addNPC(d) end
end
local function refreshEnts()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        local ch = p.Character
        if p ~= lp and ch then
            local h = ch:FindFirstChildOfClass("Humanoid")
            local r = ch:FindFirstChild("HumanoidRootPart")
            if h and r then table.insert(list, { ch = ch, h = h, r = r, name = p.Name, plr = p }) end
        end
    end
    for h in pairs(npcSet) do
        local ch = h.Parent
        if ch and ch.Parent then
            local r = ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso") or ch:FindFirstChild("UpperTorso")
            if r then table.insert(list, { ch = ch, h = h, r = r, name = ch.Name, plr = nil }) end
        end
    end
    ents = list
end
local function valid(e, mode)
    if not (e.ch.Parent and e.h.Health > 0) then return false end
    if e.plr then
        if mode == 2 then return false end
        if S.TeamCheck and not isEnemy(e.plr) then return false end
    else
        if mode == 1 then return false end
    end
    return true
end
local function entPart(e, mode)
    if mode == 1 then return e.ch:FindFirstChild("Head") or e.r end
    return e.ch:FindFirstChild("UpperTorso") or e.ch:FindFirstChild("Torso") or e.r
end
local function nearestEnt(mode)
    local r = root()
    if not r then return nil end
    local best, bd
    for _, e in ipairs(ents) do
        if valid(e, mode) then
            local d = (e.r.Position - r.Position).Magnitude
            if not bd or d < bd then best, bd = e, d end
        end
    end
    return best, bd
end

local visParams = RaycastParams.new()
visParams.FilterType = Enum.RaycastFilterType.Exclude
local function visible(part, e)
    local c = cam()
    if not (c and part) then return false end
    visParams.FilterDescendantsInstances = { lp.Character, c }
    local origin = c.CFrame.Position
    local res = workspace:Raycast(origin, part.Position - origin, visParams)
    return res == nil or res.Instance:IsDescendantOf(e.ch)
end

-- closest entity to the crosshair inside fov (pixels)
local function getTarget(fov, partMode, needVisible)
    local c = cam()
    if not c then return nil end
    local vp = c.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local best, bd, bpart, bscr
    for _, e in ipairs(ents) do
        if valid(e, S.Targets) then
            local modes = (partMode == 3) and { 1, 2 } or { partMode }
            for _, m in ipairs(modes) do
                local part = entPart(e, m)
                if part then
                    local v, on = c:WorldToViewportPoint(part.Position)
                    if on and v.Z > 0 then
                        local scr = Vector2.new(v.X, v.Y)
                        local d = (scr - center).Magnitude
                        if d <= fov and (not bd or d < bd) then
                            if not needVisible or visible(part, e) then
                                best, bd, bpart, bscr = e, d, part, scr
                            end
                        end
                    end
                end
            end
        end
    end
    return best, bpart, bscr
end

-- ---- aimbot (mouse based, camera as fallback)
local aimTarget, aimPart
local function aimActive()
    if S.AimKey == 2 then return true end
    if S.AimKey == 3 then return UIS:IsKeyDown(Enum.KeyCode.LeftAlt) end
    return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
end
local function aimStep()
    aimTarget, aimPart = nil, nil
    if not S.Aim or not aimActive() then return end
    local e, part, scr = getTarget(S.AimFOV, S.AimPart, S.WallCheck)
    aimTarget, aimPart = e, part
    if not (e and part and scr) then return end
    local c = cam()
    local vp = c.ViewportSize
    local center = Vector2.new(vp.X / 2, vp.Y / 2)
    local div = 1 + S.Smooth * 0.2
    local delta = (scr - center) / div
    if S.AimMethod ~= 3 and mousemoverel then
        pcall(mousemoverel, delta.X, delta.Y)
        return
    end
    c.CFrame = c.CFrame:Lerp(CFrame.lookAt(c.CFrame.Position, part.Position), 1 / div)
end

-- ---- silent aim (redirects the game's shot rays, needs hook support)
local silentTarget
local hooked = false
local function installHook()
    if hooked then return true end
    if not (hookmetamethod and newcclosure and getnamecallmethod and checkcaller) then return false end
    local ok2 = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if alive and S.Silent and silentTarget and self == workspace
                and (method == "Raycast" or method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "FindPartOnRayWithWhitelist")
                and not checkcaller() then
                local c = workspace.CurrentCamera
                local tp = silentTarget.Parent and silentTarget.Position
                if c and tp then
                    local args = table.pack(...)
                    if method == "Raycast" then
                        local origin, dir = args[1], args[2]
                        if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" and dir.Magnitude > 0
                            and (origin - c.CFrame.Position).Magnitude < 10 and dir.Unit:Dot(c.CFrame.LookVector) > 0.85 then
                            args[2] = (tp - origin).Unit * dir.Magnitude
                            return old(self, table.unpack(args, 1, args.n))
                        end
                    else
                        local ray = args[1]
                        if typeof(ray) == "Ray" and (ray.Origin - c.CFrame.Position).Magnitude < 10 and ray.Direction.Unit:Dot(c.CFrame.LookVector) > 0.85 then
                            args[1] = Ray.new(ray.Origin, (tp - ray.Origin).Unit * ray.Direction.Magnitude)
                            return old(self, table.unpack(args, 1, args.n))
                        end
                    end
                end
            end
            return old(self, ...)
        end))
    end)
    hooked = ok2
    return ok2
end
local function silentStep()
    silentTarget = nil
    if not S.Silent then return end
    local _, part = getTarget(S.SilentFOV, S.SilentPart, S.SilentVis)
    silentTarget = part
end

