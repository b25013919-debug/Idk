    local holder = new("Frame", { Size = UDim2.fromOffset(470, 340), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), BackgroundTransparency = 1 }, f)
    local scale = math.min(1, (vp.X - 24) / 470, (vp.Y - 24) / 340)
    new("UIScale", { Scale = scale }, holder)
    tw(f, 0.5, { GroupTransparency = 0 })
    local logo = makeLogo(holder, 40, UDim2.new(0.5, -20, 0, 0))
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 50), BackgroundTransparency = 1, Text = "Choose your device",
        TextColor3 = TX, Font = Enum.Font.Code, TextSize = 22,
    }, holder)
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 80), BackgroundTransparency = 1, Text = "Layout and controls adapt to your choice",
        TextColor3 = MU, Font = Enum.Font.Code, TextSize = 12,
    }, holder)

    local function card(x, title, sub, dev, drawFn, delay)
        local c = new("CanvasGroup", { Size = UDim2.fromOffset(215, 230), Position = UDim2.fromOffset(x, 130), BackgroundColor3 = PANEL, GroupTransparency = 1 }, holder)
        corner(c, 16)
        local st = stroke(c, ACC, 1.5, 0.6)
        local cs = new("UIScale", { Scale = 0.92 }, c)
        local pic = new("Frame", { Size = UDim2.fromOffset(140, 112), Position = UDim2.new(0.5, -70, 0, 22), BackgroundTransparency = 1 }, c)
        drawFn(pic)
        task.delay(delay, function()
            tw(c, 0.6, { GroupTransparency = 0 })
            tw(cs, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
        end)
        task.delay(delay + 0.5, function()
            if pic.Parent then
                TS:Create(pic, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Position = UDim2.new(0.5, -70, 0, 14) }):Play()
            end
        end)
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 26), Position = UDim2.fromOffset(0, 150), BackgroundTransparency = 1, Text = title,
            TextColor3 = TX, Font = Enum.Font.Code, TextSize = 20,
        }, c)
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 178), BackgroundTransparency = 1, Text = sub,
            TextColor3 = MU, Font = Enum.Font.Code, TextSize = 12,
        }, c)
        local b = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, c)
        b.MouseEnter:Connect(function()
            tw(cs, 0.25, { Scale = 1.04 }, Enum.EasingStyle.Back)
            tw(st, 0.25, { Transparency = 0.1 })
        end)
        b.MouseLeave:Connect(function()
            tw(cs, 0.25, { Scale = 1 })
            tw(st, 0.25, { Transparency = 0.6 })
        end)
        b.Activated:Connect(function()
            if chosen then return end
            chosen = dev
            tw(cs, 0.3, { Scale = 1.08 }, Enum.EasingStyle.Back)
            tw(st, 0.3, { Transparency = 0 })
        end)
    end
    card(0, "PC", "Mouse and keyboard", "PC", drawPC, 0.25)
    card(255, "Mobile", "Touch controls", "Phone", drawPhone, 0.4)

    repeat task.wait(0.05) until chosen or not alive
    task.wait(0.35)
    tw(f, 0.4, { GroupTransparency = 1 })
    task.wait(0.45)
    f:Destroy()
    return chosen or "PC"
end

