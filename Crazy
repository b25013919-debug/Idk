    warn("[Claude Nexus] " .. tostring(err))
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Claude Nexus: error", Text = tostring(err):sub(1, 200), Duration = 20 })
    end)
