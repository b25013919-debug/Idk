-- ---- movement
local flyBV, flyBG
local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    local h = hum()
    if h then h.PlatformStand = false end
end
local function bhopStep(h)
    if not S.Bhop then return end
    local want
    if S.BhopMode == 1 then want = UIS:IsKeyDown(Enum.KeyCode.Space) else want = h.MoveDirection.Magnitude > 0 end
    if want and h.FloorMaterial ~= Enum.Material.Air then h:ChangeState(Enum.HumanoidStateType.Jumping) end
end
local function moveStep()
    local h, r = hum(), root()
    if not (h and r) then return end
    if S.Speed then h.WalkSpeed = S.SpeedV end
    if S.Jump then h.UseJumpPower = true h.JumpPower = S.JumpV end
    if S.AutoHeal and h.Health > 0 then h.Health = h.MaxHealth end
    bhopStep(h)
    if S.Fly then
        local c = cam()
        if not flyBV or flyBV.Parent ~= r then
            stopFly()
            flyBV = new("BodyVelocity", { MaxForce = Vector3.new(1e9, 1e9, 1e9), Velocity = Vector3.zero }, r)
            flyBG = new("BodyGyro", { MaxTorque = Vector3.new(1e9, 1e9, 1e9), P = 1e4, CFrame = r.CFrame }, r)
        end
        h.PlatformStand = true
        local md, look, vel = h.MoveDirection, c.CFrame.LookVector, Vector3.zero
        if md.Magnitude > 0 then
            local flat = Vector3.new(look.X, 0, look.Z)
            local fwd = flat.Magnitude > 0 and md:Dot(flat.Unit) or 0
            vel = md * S.FlySpeed + Vector3.new(0, look.Y * S.FlySpeed * math.max(fwd, 0), 0)
        end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then vel = vel + Vector3.new(0, S.FlySpeed, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vel = vel - Vector3.new(0, S.FlySpeed, 0) end
        flyBV.Velocity, flyBG.CFrame = vel, c.CFrame
    end
end

