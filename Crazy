            Size = UDim2.new(1 / #THEMES, -5, 1, 0), BackgroundColor3 = t[2]:Lerp(Color3.new(0, 0, 0), 0.35), Text = t[1], TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.Code, TextSize = 11, AutoButtonColor = false, LayoutOrder = idx,
        }, trow)
        corner(b, 5)
        stroke(b, t[2], 1.5, 0.2)
        b.MouseEnter:Connect(function() tw(b, 0.15, { BackgroundColor3 = t[2]:Lerp(Color3.new(0, 0, 0), 0.1) }) end)
        b.MouseLeave:Connect(function() tw(b, 0.15, { BackgroundColor3 = t[2]:Lerp(Color3.new(0, 0, 0), 0.35) }) end)
        b.Activated:Connect(function()
            setAccent(t[2])
            notify("Theme: " .. t[1], "Accent color updated", t[2])
        end)
    end
    section(pCfg, "Config")
    button(pCfg, "Save settings", function()
        if saveSettings() then notify("Saved", "Settings will load on next start", GRN) else notify("Could not save", "No file access", RED) end
    end)
    button(pCfg, "Delete saved settings", function()
        pcall(function() if delfile and isfile(SAVE) then delfile(SAVE) end end)
        notify("Deleted", "Saved settings removed", AMB)
    end, Color3.fromRGB(90, 16, 40))
    section(pCfg, "Menu")
    button(pCfg, "Change device", function()
        if obj.destroy then obj.destroy() end
        task.spawn(function()
            local ok2, e2 = pcall(function()
                local d2 = pickDevice()
                local diag2 = loader(d2)
                buildMain(d2, diag2)
            end)
            if not ok2 then reportError(e2) end
        end)
    end)
    button(pCfg, "Unload Claude Nexus", function() teardown() end, Color3.fromRGB(90, 16, 40))

    selectTab(1)

    -- floating icon (toggle menu)
    local fsize = PC and 42 or 50
    local fb = new("Frame", { Size = UDim2.fromOffset(fsize, fsize), Position = UDim2.new(0, 10, 0.5, -60), BackgroundTransparency = 1 }, gui)
    local fIcon = makeLogo(fb, fsize, UDim2.fromOffset(0, 0))
    stroke(fIcon, MAG, 1.5, 0.2)
    local fh = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5 }, fb)
    makeDraggable(fh, fb, function() setOpen(not open) end)
    btnMin.Activated:Connect(function() setOpen(false) end)
    btnClose.Activated:Connect(function() teardown() end)

    obj.destroy = function()
        for i = #conns, startIdx + 1, -1 do
            pcall(function() conns[i]:Disconnect() end)
            table.remove(conns, i)
        end
        pcall(function() RS:UnbindFromRenderStep("CA_Late") end)
        pcall(function() win:Destroy() end)
        pcall(function() fb:Destroy() end)
        pcall(function() toasts:Destroy() end)
        for k in pairs(refreshers) do refreshers[k] = nil end
        mainObj = nil
    end
    mainObj = obj

    -- world tracking
    scanNPCs()
    refreshEnts()
    bind(workspace.DescendantAdded, addNPC)
    rebuildList()
    bind(Players.PlayerAdded, function() task.delay(0.6, rebuildList) end)
    bind(Players.PlayerRemoving, function() task.delay(0.3, rebuildList) end)
    if S.Sky ~= 1 then applySky() end

    -- input
    bind(UIS.InputBegan, function(i, gp)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            firing = true
            if S.ClickTP and UIS:IsKeyDown(Enum.KeyCode.LeftControl) and not gp then
                local m = lp:GetMouse()
                local r = root()
                if r and m and m.Hit then r.CFrame = CFrame.new(m.Hit.Position + Vector3.new(0, 3, 0)) end
            end
        end
        if gp then return end
        if i.KeyCode == Enum.KeyCode.RightControl then setOpen(not open) end
        if not (S.Keybinds and PC) then return end
        local map = { [Enum.KeyCode.Z] = "Aim", [Enum.KeyCode.X] = "Silent", [Enum.KeyCode.V] = "ESP", [Enum.KeyCode.B] = "Bhop", [Enum.KeyCode.K] = "KAura", [Enum.KeyCode.G] = "Farm" }
        local k = map[i.KeyCode]
        if k then
            if k == "Silent" and not S.Silent and not installHook() then
                notify("Silent aim", "No hook support", RED)
                return
            end
            S[k] = not S[k]
            if refreshers[k] then refreshers[k]() end
            if k == "ESP" and not S.ESP then clearAllESP() end
            if k == "Farm" and S.Farm then
                farmHits, farmKills, farmStart = 0, 0, tick()
            end
            notify(k, S[k] and "ON" or "OFF", S[k] and GRN or MU)
        end
    end)
    bind(UIS.InputEnded, function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then firing = false end
    end)
    bind(UIS.JumpRequest, function()
        if S.Inf then
            local h = hum()
            if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)
    bind(RS.Stepped, function()
        if S.Noclip and lp.Character then
            for _, p in ipairs(lp.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        end
    end)
    bind(lp.Idled, function()
        if S.AntiAFK then
            pcall(function()
                local VU = game:GetService("VirtualUser")
                VU:CaptureController()
                VU:ClickButton2(Vector2.new())
            end)
        end
    end)

    pcall(function() RS:UnbindFromRenderStep("CA_Late") end)
    RS:BindToRenderStep("CA_Late", 2001, lateStep)
    bind(RS.RenderStepped, function(dt)
        fpsVal = fpsVal * 0.92 + (1 / math.max(dt, 0.001)) * 0.08
        local c = cam()
        if not c then return end
        if S.FOV then c.FieldOfView = S.FOVV end
        if S.Fullbright then Lighting.Brightness, Lighting.GlobalShadows = 2, false end
    end)
    bind(RS.Heartbeat, function() pcall(moveStep) pcall(hitboxStep) end)

    -- entity list
    task.spawn(function()
        while alive and mainObj == obj do
            pcall(refreshEnts)
            task.wait(0.25)
        end
    end)
    -- kill aura, farm, survival
    task.spawn(function()
        while alive and mainObj == obj do
            pcall(auraStepK)
            pcall(farmStep)
            pcall(retreatStep)
            task.wait(0.12)
        end
    end)
    -- weapon mods
    task.spawn(function()
        while alive and mainObj == obj do
            pcall(modsStep)
            task.wait(1)
        end
    end)
    -- pickups, prompt collector, item ESP
    task.spawn(function()
        while alive and mainObj == obj do
            pcall(function()
                local r = root()
                if S.ItemESP or (S.AutoPick and r) then
                    local items = itemScan()
                    for i, it in ipairs(items) do
                        local hl = it.tool:FindFirstChild("CA_ItemHL")
                        if S.ItemESP and i <= 60 then
                            if not hl then
                                new("Highlight", { Name = "CA_ItemHL", FillColor = Color3.fromRGB(255, 230, 0), OutlineColor = Color3.fromRGB(255, 255, 160), FillTransparency = 0.35, DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, it.tool)
                            end
                        elseif hl then
                            hl:Destroy()
                        end
                        if S.AutoPick and r and firetouchinterest and (it.part.Position - r.Position).Magnitude <= S.PickRange then
                            firetouchinterest(r, it.part, 0)
                            firetouchinterest(r, it.part, 1)
                        end
                    end
                end
                if S.Collect and S.CollectFilter ~= "" and fireproximityprompt and r then
                    local fl = S.CollectFilter
                    local bestPrompt, bestPart, bd
                    for _, d in ipairs(workspace:GetDescendants()) do
                        if d:IsA("ProximityPrompt") and d.Enabled then
                            local part = d.Parent
                            if part and part:IsA("BasePart") then
                                local nm = string.lower(part.Name .. " " .. d.ObjectText .. " " .. d.ActionText)
                                if string.find(nm, fl, 1, true) then
                                    local dist = (part.Position - r.Position).Magnitude
                                    if not bd or dist < bd then bestPrompt, bestPart, bd = d, part, dist end
                                end
                            end
                        end
                    end
                    if bestPrompt then
                        local back = r.CFrame
                        r.CFrame = bestPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.2)
                        pcall(fireproximityprompt, bestPrompt)
                        task.wait(0.2)
                        local r2 = root()
                        if r2 then r2.CFrame = back end
                    end
                end
            end)
            task.wait(1.5)
        end
    end)
    -- status
    task.spawn(function()
        while alive and mainObj == obj do
            pcall(function()
                pingMs = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                footer.Text = math.floor(pingMs) .. " ms  |  " .. math.floor(fpsVal) .. " FPS"
                local function tag(on, col) return '<font color="' .. hex(on and col or MU) .. '">' .. (on and "ON" or "OFF") .. "</font>" end
                cStatus.Text = "Aim: " .. tag(S.Aim, GRN) .. "   Silent: " .. tag(S.Silent, RED) .. "   Fire: " .. tag(S.AutoFire, RED) .. "   Aura: " .. tag(S.KAura, RED)
                    .. "\nTarget: " .. (aimTarget and aimTarget.name or "-") .. "   |   Hook: " .. (hooked and "ready" or "off")
                local t = farmStart and (tick() - farmStart) or 0
                fStatus.Text = "Auto Farm: " .. tag(S.Farm, GRN) .. "\nKills: " .. farmKills .. "   Hits: " .. farmHits .. "   Time: " .. string.format("%d:%02d", math.floor(t / 60), math.floor(t % 60))
                    .. (retreating and "   [retreating]" or "")
                local tool = equippedTool()
                wStatus.Text = "Weapon: " .. (tool and tool.Name or "none equipped") .. "\nMods: " .. (S.WMods and "ON" or "OFF") .. "   Entities: " .. #ents
            end)
            task.wait(0.25)
        end
    end)
    -- viewmodel and aura
    task.spawn(function()
        while alive and mainObj == obj do
            pcall(function()
                if S.ArmMode ~= 1 or S.WeapMode ~= 1 or S.ThirdPerson then
                    applyVM()
                elseif next(vmOrig) then
                    restoreVM()
                end
                if S.Aura then auraStep() end
            end)
            task.wait(0.1)
        end
    end)

    task.delay(0.2, function()
        if alive and mainObj == obj then
            setOpen(true)
            notify("Claude Nexus online", PC and "RightCtrl or the icon on the left toggles the menu" or "Tap the icon on the left to open or hide the menu", ACC)
        end
    end)
end

-- ================= START =================
task.spawn(function()
    local ok2, e2 = pcall(function()
        intro()
        local device = pickDevice()
        local diag = loader(device)
        buildMain(device, diag)
    end)
    if not ok2 then reportError(e2) end
end)

