    }, card)
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 90), BackgroundTransparency = 1,
        Text = "Bloody Playground  //  " .. (device == "PC" and "PC mode" or "Mobile mode"), TextColor3 = MU, Font = Enum.Font.Code, TextSize = 11,
    }, card)

    local rows = new("Frame", { Size = UDim2.new(1, -40, 0, 118), Position = UDim2.fromOffset(20, 116), BackgroundTransparency = 1 }, card)
    new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, rows)
    local track = new("Frame", { Size = UDim2.new(1, -40, 0, 8), Position = UDim2.fromOffset(20, 250), BackgroundColor3 = ITEM, BorderSizePixel = 0 }, card)
    corner(track, 4)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = ACC, BorderSizePixel = 0 }, track)
    corner(fill, 4)
    local fg = new("UIGradient", { Color = ColorSequence.new(ACC, WHITE), Rotation = 0 }, fill)
    local pct = new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 266), BackgroundTransparency = 1, Text = "0%",
        TextColor3 = MU, Font = Enum.Font.Code, TextSize = 12,
    }, card)
    local nv = new("NumberValue", { Value = 0 }, card)
    nv.Changed:Connect(function(v) pct.Text = math.floor(v) .. "%" end)

    local function addRow(text)
        local row = new("Frame", { Size = UDim2.new(1, 0, 0, 20), BackgroundTransparency = 1, LayoutOrder = O() }, rows)
        local dot = new("Frame", { Size = UDim2.fromOffset(8, 8), Position = UDim2.fromOffset(0, 6), BackgroundColor3 = OFF, BorderSizePixel = 0 }, row)
        corner(dot, 4)
        local lbl = new("TextLabel", {
            Size = UDim2.new(1, -216, 1, 0), Position = UDim2.fromOffset(16, 0), BackgroundTransparency = 1, Text = text,
            TextColor3 = MU, Font = Enum.Font.Code, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
        local tag = new("TextLabel", {
            Size = UDim2.fromOffset(200, 20), Position = UDim2.new(1, -200, 0, 0), BackgroundTransparency = 1, Text = "",
            TextColor3 = GRN, Font = Enum.Font.Code, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, TextTransparency = 1,
        }, row)
        return dot, lbl, tag
    end

    local result = {}
    local steps = {
        { "Loading assets", function()
            task.wait(0.55)
            return "READY", GRN
        end },
        { "Loading functions", function()
            task.wait(0.35)
            local okl = loadSettings()
            return okl and "SETTINGS LOADED" or "DEFAULTS", okl and GRN or AMB
        end },
        { "Scanning world", function()
            task.wait(0.4)
            local n = 0
            for _, d in ipairs(workspace:GetDescendants()) do
                if d:IsA("Humanoid") then n = n + 1 end
            end
            result.humanoids = n
            return n .. " ENTITIES / " .. #Players:GetPlayers() .. " PLAYERS", GRN
        end },
        { "Checking executor", function()
            task.wait(0.3)
            result.drawing = (DrawingLib and DrawingLib.new) and true or false
            result.mouse = mousemoverel and true or false
            result.hook = (hookmetamethod and newcclosure and getnamecallmethod and checkcaller) and true or false
            result.click = mouse1click and true or false
            local parts = {
                result.drawing and "DRAW" or "NO DRAW",
                result.mouse and "MOUSE" or "NO MOUSE",
                result.hook and "HOOK" or "NO HOOK",
            }
            local good = result.drawing and result.mouse and result.hook
            return table.concat(parts, " / "), good and GRN or AMB
        end },
        { "Building interface", function()
            task.wait(0.5)
            return "DONE", GRN
        end },
    }
    for i, st in ipairs(steps) do
        local dot, lbl, tag = addRow(st[1])
        tw(dot, 0.25, { BackgroundColor3 = ACC })
        tw(lbl, 0.25, { TextColor3 = TX })
        local text, col = st[2]()
        tag.Text = text
        tag.TextColor3 = col
        tw(tag, 0.3, { TextTransparency = 0 })
        tw(dot, 0.25, { BackgroundColor3 = col })
        local target = i / #steps
        tw(fill, 0.45, { Size = UDim2.new(target, 0, 1, 0) })
        tw(nv, 0.45, { Value = target * 100 })
        task.wait(0.15)
    end
    task.wait(0.4)
    tw(f, 0.5, { GroupTransparency = 1 })
    if blur then tw(blur, 0.8, { Size = 0 }) end
    task.wait(0.55)
    f:Destroy()
    return result
end

