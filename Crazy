        color = color or ACC
        local t = new("CanvasGroup", { Size = UDim2.new(1, 0, 0, 52), BackgroundColor3 = BG, GroupTransparency = 1, LayoutOrder = O() }, toasts)
        corner(t, 10)
        stroke(t, color, 1, 0.4)
