local function farmStep()
    if not S.Farm or retreating then return end
    local r, h = root(), hum()
    if not (r and h) or h.Health <= 0 then return end
    local e = nearestEnt(S.FarmPlayers and 3 or 2)
    if not e then return end
    local tr = e.r
    local pos
    if S.FarmMode == 1 then
        pos = (tr.CFrame * CFrame.new(0, 0, S.FarmDist)).Position
    elseif S.FarmMode == 2 then
        local a = tick() * 2.5
        pos = tr.Position + Vector3.new(math.cos(a) * S.FarmDist, 0, math.sin(a) * S.FarmDist)
    else
        pos = tr.Position + Vector3.new(0, S.FarmDist + 6, 0)
    end
    r.CFrame = CFrame.lookAt(pos, tr.Position)
    r.AssemblyLinearVelocity = Vector3.zero
    attackEnt(e)
    farmHits = farmHits + 1
    if S.FarmGun then
        local c = cam()
        local head = e.ch:FindFirstChild("Head") or tr
        if c then c.CFrame = CFrame.lookAt(c.CFrame.Position, head.Position) end
        clickFire()
    end
    if e.h.Health <= 0 and not killedSeen[e.h] then
        killedSeen[e.h] = true
        farmKills = farmKills + 1
    end
end

-- ---- weapon mods (attributes, value objects and settings modules of the equipped tool)
local AMMO_K = { "ammo", "clip", "magazine", "bullets", "rounds" }
local DELAY_K = { "cooldown", "delay", "interval", "reload", "firerate", "fire_rate", "timebetween" }
local SPREAD_K = { "spread", "recoil", "sway", "shake", "kick", "inaccura" }
local DMG_K = { "damage", "dmg" }
local modRestore = {}
local modGen, modded = 1, setmetatable({}, { __mode = "k" })
local function has(n, list)
    n = string.lower(tostring(n))
    for _, k in ipairs(list) do
        if string.find(n, k, 1, true) then return true end
    end
    return false
end
local function newValue(name, cur)
    if type(cur) ~= "number" then return nil end
    if S.InfAmmo and has(name, AMMO_K) then return math.max(cur, 9999) end
    if S.RapidFire and has(name, DELAY_K) and cur > 0 and cur <= 5 then return 0.02 end
    if S.NoRecoil and has(name, SPREAD_K) and cur ~= 0 then return 0 end
    if S.DmgMult > 1 and has(name, DMG_K) and cur > 0 then return cur * S.DmgMult end
    return nil
end
local function modTable(t, depth)
    for k, v in pairs(t) do
        if type(v) == "number" then
            local nv = newValue(k, v)
            if nv then
                local old = v
                table.insert(modRestore, function() pcall(function() t[k] = old end) end)
                t[k] = nv
            end
        elseif type(v) == "table" and depth < 2 then
            modTable(v, depth + 1)
        end
    end
end
local function applyTool(tool)
    for k, v in pairs(tool:GetAttributes()) do
        local nv = newValue(k, v)
        if nv then
            local old = v
            table.insert(modRestore, function() pcall(function() tool:SetAttribute(k, old) end) end)
            tool:SetAttribute(k, nv)
        end
    end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("NumberValue") or d:IsA("IntValue") then
            local nv = newValue(d.Name, d.Value)
            if nv then
                local old = d.Value
                table.insert(modRestore, function() pcall(function() d.Value = old end) end)
                d.Value = nv
            end
        elseif d:IsA("ModuleScript") and has(d.Name, { "setting", "config", "stat", "data", "gun" }) then
            pcall(function()
                local t = require(d)
                if type(t) == "table" then modTable(t, 0) end
            end)
        end
        for k, v in pairs(d:GetAttributes()) do
            local nv = newValue(k, v)
            if nv then
                local old = v
                table.insert(modRestore, function() pcall(function() d:SetAttribute(k, old) end) end)
                d:SetAttribute(k, nv)
            end
        end
    end
end
local function restoreMods()
    for i = #modRestore, 1, -1 do pcall(modRestore[i]) end
    modRestore = {}
    modGen = modGen + 1
end
local function modsStep()
    if not S.WMods then return end
    local list = {}
    local c, b = lp.Character, lp:FindFirstChild("Backpack")
    if c then for _, x in ipairs(c:GetChildren()) do if x:IsA("Tool") then table.insert(list, x) end end end
    if b then for _, x in ipairs(b:GetChildren()) do if x:IsA("Tool") then table.insert(list, x) end end end
    for _, tool in ipairs(list) do
        if modded[tool] ~= modGen then
            modded[tool] = modGen
            pcall(applyTool, tool)
        elseif S.InfAmmo then
            -- keep ammo topped up while shooting
            for k, v in pairs(tool:GetAttributes()) do
                if type(v) == "number" and has(k, AMMO_K) and v < 5000 then tool:SetAttribute(k, 9999) end
            end
            for _, d in ipairs(tool:GetDescendants()) do
                if (d:IsA("NumberValue") or d:IsA("IntValue")) and has(d.Name, AMMO_K) and d.Value < 5000 then d.Value = 9999 end
            end
        end
    end
end
local function scanToolValues()
    local t = equippedTool()
    if not t then return "Equip a weapon first" end
    local found = {}
    for k, v in pairs(t:GetAttributes()) do
        if type(v) == "number" then table.insert(found, k .. "=" .. tostring(v)) end
    end
    for _, d in ipairs(t:GetDescendants()) do
        if d:IsA("NumberValue") or d:IsA("IntValue") then table.insert(found, d.Name .. "=" .. tostring(d.Value)) end
    end
    if #found == 0 then return t.Name .. ": no numeric values found (settings may be in a module)" end
    local out = {}
    for i = 1, math.min(#found, 14) do out[i] = found[i] end
    return t.Name .. ": " .. table.concat(out, ", ")
end

